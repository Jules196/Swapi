<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Accent colours of the classic style. Every style defines the same keys. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF3B5BDB" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#FF8DA2F0" />
</ResourceDictionary>
