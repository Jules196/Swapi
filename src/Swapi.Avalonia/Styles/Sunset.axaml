<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Accent colours of the sunset style. Every style defines the same keys. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FFC2410C" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#FFF0A17A" />
</ResourceDictionary>
