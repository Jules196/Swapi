<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Swapi.Avalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="560"
        x:Class="Swapi.Avalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="SWAPI Explorer"
        Width="980"
        Height="560"
        MinWidth="820"
        MinHeight="420">

    <Design.DataContext>
        <x:Null />
    </Design.DataContext>

    <Grid Margin="{DynamicResource LayoutMargin}" RowDefinitions="Auto,Auto,*">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock FontSize="{DynamicResource TitleFontSize}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}"
                       Text="Star Wars Characters" />
            <!--
                Appearance selection: theme (colours), style (accents) and
                metrics (sizes and spacings) are switched independently.
            -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8">
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource SubtleForegroundBrush}"
                           Text="Theme" />
                <ComboBox x:Name="ThemeSelector"
                          Width="110"
                          VerticalAlignment="Center"
                          SelectionChanged="OnThemeSelectionChanged" />
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource SubtleForegroundBrush}"
                           Text="Style" />
                <ComboBox x:Name="StyleSelector"
                          Width="110"
                          VerticalAlignment="Center"
                          SelectionChanged="OnStyleSelectionChanged" />
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource SubtleForegroundBrush}"
                           Text="Metrics" />
                <ComboBox x:Name="MetricsSelector"
                          Width="120"
                          VerticalAlignment="Center"
                          SelectionChanged="OnMetricsSelectionChanged" />
                <Button Margin="4,0,0,0"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="{DynamicResource AccentForegroundBrush}"
                        Command="{Binding LoadPeopleCommand}"
                        Content="Refresh"
                        Padding="{DynamicResource ControlPadding}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,12,0,16">
            <ProgressBar Height="4"
                         Foreground="{DynamicResource AccentBrush}"
                         IsIndeterminate="True"
                         IsVisible="{Binding IsBusy}" />
            <TextBlock Margin="0,8,0,0"
                       Foreground="{DynamicResource ErrorForegroundBrush}"
                       Text="{Binding ErrorMessage}" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="2*,320" ColumnSpacing="20">
            <Border BorderBrush="{DynamicResource CardBorderBrush}"
                   BorderThickness="1"
                   CornerRadius="{DynamicResource ControlCornerRadius}">
                <ListBox ItemsSource="{Binding People}">
                   <ListBox.ItemTemplate>
                       <DataTemplate>
                           <TextBlock Padding="{DynamicResource ItemPadding}" Text="{Binding Name}" />
                       </DataTemplate>
                   </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="1"
                   Padding="{DynamicResource CardPadding}"
                   Background="{DynamicResource CardBackgroundBrush}"
                   BorderBrush="{DynamicResource CardBorderBrush}"
                   BorderThickness="1"
                   CornerRadius="{DynamicResource ControlCornerRadius}">
                <StackPanel Spacing="{DynamicResource StackSpacing}">
                   <TextBlock FontSize="{DynamicResource SectionFontSize}"
                              FontWeight="SemiBold"
                              Foreground="{DynamicResource AccentBrush}"
                              Text="Statistics" />

                   <TextBlock Margin="{DynamicResource SectionMargin}" Text="Current year" />
                   <TextBox Padding="{DynamicResource ControlPadding}" Text="{Binding CurrentYear}" />
                   <TextBlock FontSize="{DynamicResource CaptionFontSize}"
                              Foreground="{DynamicResource ErrorForegroundBrush}"
                              Text="{Binding CurrentYearError}"
                              TextWrapping="Wrap" />

                   <TextBlock Margin="{DynamicResource SectionMargin}"
                              Foreground="{DynamicResource SubtleForegroundBrush}"
                              Text="Average height" />
                   <TextBlock FontSize="{DynamicResource ValueFontSize}" Text="{Binding AverageHeight}" />

                   <TextBlock Margin="{DynamicResource SectionMargin}"
                              Foreground="{DynamicResource SubtleForegroundBrush}"
                              Text="Average age" />
                   <TextBlock FontSize="{DynamicResource ValueFontSize}" Text="{Binding AverageAge}" />

                   <TextBlock Margin="{DynamicResource SectionMargin}"
                              Foreground="{DynamicResource SubtleForegroundBrush}"
                              Text="Male ratio" />
                   <TextBlock FontSize="{DynamicResource ValueFontSize}" Text="{Binding MalePercentage}" />

                   <TextBlock Margin="{DynamicResource SectionMargin}"
                              Foreground="{DynamicResource SubtleForegroundBrush}"
                              Text="Female ratio" />
                   <TextBlock FontSize="{DynamicResource ValueFontSize}" Text="{Binding FemalePercentage}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>

</Window>
