<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Swapi.Avalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Swapi.Avalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Swapi.Avalonia">

    <Design.DataContext>
        <x:Null />
    </Design.DataContext>

    <Grid Margin="24" RowDefinitions="Auto,Auto,*">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock FontSize="24"
                       FontWeight="SemiBold"
                       Text="Star Wars characters" />
            <Button Grid.Column="1"
                    Command="{Binding LoadPeopleCommand}"
                    Content="Refresh"
                    Padding="12,6" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,12">
            <ProgressBar Height="4"
                         IsIndeterminate="True"
                         IsVisible="{Binding IsBusy}" />
            <TextBlock Margin="0,8,0,0"
                       Foreground="Firebrick"
                       Text="{Binding ErrorMessage}" />
        </StackPanel>

        <ListBox Grid.Row="2"
                 ItemsSource="{Binding People}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Padding="8,4" Text="{Binding Name}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>

</Window>
