<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Swapi.Avalonia.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <!--
                Own colours per theme variant. Avalonia picks the matching
                dictionary for the active variant, so views only need to
                reference the keys with DynamicResource.
            -->
            <ResourceDictionary.MergedDictionaries>
                <!-- Start-up accents and metrics; ThemeManager exchanges these at runtime. -->
                <ResourceInclude Source="avares://Swapi.Avalonia/Styles/Classic.axaml" />
                <ResourceInclude Source="avares://Swapi.Avalonia/Metrics/Comfortable.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFF6F7F9" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#FFD0D3D8" />
                    <SolidColorBrush x:Key="SubtleForegroundBrush" Color="#FF5F6368" />
                    <SolidColorBrush x:Key="ErrorForegroundBrush" Color="#FFB3261E" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FF26262B" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#FF44464F" />
                    <SolidColorBrush x:Key="SubtleForegroundBrush" Color="#FFB0B3BA" />
                    <SolidColorBrush x:Key="ErrorForegroundBrush" Color="#FFF2B8B5" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
