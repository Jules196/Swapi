<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Sizes and spacings of the comfortable metrics. Every metric set defines the same keys. -->
    <sys:Double x:Key="TitleFontSize">24</sys:Double>
    <sys:Double x:Key="SectionFontSize">18</sys:Double>
    <sys:Double x:Key="ValueFontSize">16</sys:Double>
    <sys:Double x:Key="BodyFontSize">13</sys:Double>
    <sys:Double x:Key="CaptionFontSize">12</sys:Double>

    <Thickness x:Key="LayoutMargin">24</Thickness>
    <Thickness x:Key="CardPadding">20</Thickness>
    <Thickness x:Key="ControlPadding">6,4</Thickness>
    <Thickness x:Key="ItemPadding">12,8</Thickness>
    <Thickness x:Key="SectionMargin">0,18,0,4</Thickness>

    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
</ResourceDictionary>
