<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Colours of the light theme. Dark.xaml defines the same keys. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFF6F7F9" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="#FF1B1B1F" />
    <SolidColorBrush x:Key="SubtleForegroundBrush" Color="#FF5F6368" />
    <SolidColorBrush x:Key="BorderBrush" Color="#FFD0D3D8" />
    <SolidColorBrush x:Key="ErrorForegroundBrush" Color="#FFB3261E" />
</ResourceDictionary>
