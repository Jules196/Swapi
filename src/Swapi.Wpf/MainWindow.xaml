<Window x:Class="Swapi.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Swapi.Wpf.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}"
        Title="SWAPI Explorer"
        Height="560"
        Width="900"
        MinHeight="420"
        MinWidth="680"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
           <RowDefinition Height="Auto" />
           <RowDefinition Height="Auto" />
           <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel>
           <TextBlock FontSize="24"
                      FontWeight="SemiBold"
                      Text="Star Wars Characters" />
           <!-- Theme selection: switches the merged theme dictionary at runtime. -->
           <StackPanel DockPanel.Dock="Right"
                       HorizontalAlignment="Right"
                       Orientation="Horizontal">
              <TextBlock Margin="0,0,8,0"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource SubtleForegroundBrush}"
                         Text="Theme" />
              <ComboBox x:Name="ThemeSelector"
                        Width="110"
                        VerticalAlignment="Center"
                        SelectionChanged="OnThemeSelectionChanged" />
              <Button Margin="12,0,0,0"
                      Command="{Binding LoadPeopleCommand}"
                      Content="Refresh"
                      Padding="12,6" />
           </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="1" Margin="0,12,0,16">
           <ProgressBar Height="4"
                        IsIndeterminate="True"
                        Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
           <TextBlock Margin="0,8,0,0"
                      Foreground="{DynamicResource ErrorForegroundBrush}"
                      Text="{Binding ErrorMessage}" />
        </StackPanel>

        <Grid Grid.Row="2">
           <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="20" />
              <ColumnDefinition Width="320" />
           </Grid.ColumnDefinitions>

           <Border Background="{DynamicResource ControlBackgroundBrush}"
                   BorderBrush="{DynamicResource BorderBrush}"
                   BorderThickness="1"
                   CornerRadius="6">
              <ListBox ItemsSource="{Binding People}">
                 <ListBox.ItemTemplate>
                    <DataTemplate>
                       <TextBlock Padding="12,8" Text="{Binding Name}" />
                    </DataTemplate>
                 </ListBox.ItemTemplate>
              </ListBox>
           </Border>

           <Border Grid.Column="2"
                   Padding="20"
                   Background="{DynamicResource CardBackgroundBrush}"
                   BorderBrush="{DynamicResource BorderBrush}"
                   BorderThickness="1"
                   CornerRadius="6">
              <StackPanel>
                 <TextBlock FontSize="18"
                            FontWeight="SemiBold"
                            Text="Statistics" />

                 <TextBlock Margin="0,18,0,6" Text="Current year" />
                 <TextBox Text="{Binding CurrentYear, UpdateSourceTrigger=PropertyChanged}" />
                 <TextBlock Margin="0,4,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource ErrorForegroundBrush}"
                            Text="{Binding CurrentYearError}"
                            TextWrapping="Wrap" />

                 <TextBlock Margin="0,18,0,4"
                            Foreground="{DynamicResource SubtleForegroundBrush}"
                            Text="Average height" />
                 <TextBlock FontSize="16" Text="{Binding AverageHeight}" />

                 <TextBlock Margin="0,18,0,4"
                            Foreground="{DynamicResource SubtleForegroundBrush}"
                            Text="Average age" />
                 <TextBlock FontSize="16" Text="{Binding AverageAge}" />

                 <TextBlock Margin="0,18,0,4"
                            Foreground="{DynamicResource SubtleForegroundBrush}"
                            Text="Male ratio" />
                 <TextBlock FontSize="16" Text="{Binding MalePercentage}" />

                 <TextBlock Margin="0,18,0,4"
                            Foreground="{DynamicResource SubtleForegroundBrush}"
                            Text="Female ratio" />
                 <TextBlock FontSize="16" Text="{Binding FemalePercentage}" />
              </StackPanel>
           </Border>
        </Grid>
    </Grid>
</Window>
