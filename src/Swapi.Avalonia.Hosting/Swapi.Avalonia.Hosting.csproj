<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- GUI application: no console window is allocated on Windows. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Declares DPI awareness and the supported Windows versions. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- Icons and other assets embedded as avares:// resources. -->
    <AvaloniaResource Include="Assets\**" />
    <!-- Configuration file read by the host at startup. -->
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <!-- Developer tools overlay; only included in Debug builds. -->
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <!-- MVVM source generators for observable properties and commands. -->
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- Generic host: configuration, logging and dependency injection. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared backend that reads the Star Wars data. -->
    <ProjectReference Include="..\..\SwapiBackend\SwapiBackend.csproj" />
  </ItemGroup>
</Project>
