<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Colours of the dark theme. Light.xaml defines the same keys. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF1B1B1F" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FF26262B" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FF2F2F35" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="#FFF2F2F5" />
    <SolidColorBrush x:Key="SubtleForegroundBrush" Color="#FFB0B3BA" />
    <SolidColorBrush x:Key="BorderBrush" Color="#FF44464F" />
    <SolidColorBrush x:Key="ErrorForegroundBrush" Color="#FFF2B8B5" />
</ResourceDictionary>
